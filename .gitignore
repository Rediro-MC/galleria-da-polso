# Build Pebble (per app)
apps/*/build/
apps/*/node_modules/
apps/*/.lock-waf*
apps/*/*.log
apps/*/test/build/
apps/*/compile_commands.json

# Screenshot e artefatti di lavoro (quelli da conservare vanno in docs/design/galleria/)
apps/*/*.png
apps/*/*.pbw

# Repo clonati come riferimento (vedi tools/README.md §1–§2 per riclonarli)
tools/sdk-docs/
tools/pebble-watchface-agent-skill/

# Python / editor
__pycache__/
*.pyc
.venv/
.vscode/
*.orig
*.rej
.DS_Store

# Runtime / sessione
*.pid
.claude/settings.local.json

# S8: build salvate per l'orologio reale (pbw + elf), rigenerabili
apps/galleria/build_s8/

# Credenziali e stati locali (mai versionare)
.env
.env.*
*.pem
*.key
*.p12
firebase_oauth_storage.json
qemu_spi_flash.bin
